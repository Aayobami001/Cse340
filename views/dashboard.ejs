<%- include('partials/header') %>
<%- include('partials/navigation') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <% if (user) { %>
        <p>Name: <%= user.name %></p>
        <p>Username: <%= user.email %></p>
    <% } else { %>
        <p>You are viewing the dashboard as a guest. <a href="/login">Log in</a> to see your account details.</p>
    <% } %>
        
    <p>
        <% if (user && user.role_name === 'admin') { %>
            <a href="/registered-users">View Registered Users</a>
        <% } %>
    </p>

    <h3>Projects I Volunteer For</h3>
    <% if (user) { %>
        <% if (volunteerProjects.length > 0) { %>
            <ul>
                <% volunteerProjects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        <form action="/dashboard/projects/<%= project.project_id %>/unvolunteer" method="POST">
                            <button type="submit">Remove me as a volunteer</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>You have not signed up to volunteer for any projects yet.</p>
        <% } %>
    <% } else { %>
        <p><a href="/login">Log in</a> to view your volunteer projects.</p>
    <% } %>

</main>

<%- include('partials/footer') %>