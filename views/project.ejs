<%- include('partials/header') %>
<%- include('partials/navigation') %>

<main>
  <h1><%= title %></h1>
  <h2><%= project.title %></h2>

  <p><strong>Description:</strong> <%= project.description %></p>
  <p><strong>Location:</strong> <%= project.location %></p>
  <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>
  <p id="edit"><a href="/edit-project/<%= project.project_id %>">Edit Project Information</a></p>
  <h3>Categories</h3>
  <ul>
    <% project.categories.forEach(category => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
    <% }); %>
    <p id="edit"><a href="/assign-category/<%= project.project_id %>">Edit Categories</a></p>

  </ul>
</main>

<%- include('partials/footer') %>