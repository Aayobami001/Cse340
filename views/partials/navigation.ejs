<nav>
    <ul class="ul-list">
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organization</a></li>
        <li><a href="/projects">Service Projects</a></li>
        <li><a href="/categories">Categories</a></li>
        <% if (isLoggedIn) { %>
                <li><a href="/logout">Logout</a></li>
