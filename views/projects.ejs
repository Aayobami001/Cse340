<%- include('partials/header') %> 
<%- include('partials/navigation') %>

<main>
  <h1><%= title %></h1>
  <p>Select a project to view its details and volunteer.</p>
    <ul>
       <% projects.forEach(project => { %>
            <li>
              <a href="/project/<%= project.service_project_id %>">
                <%= project.title %><% if (user) { %> — View details and volunteer<% } %>
              </a>
              <span>Organization:
                <% if (project.organization_id) { %>
                  <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                <% } else { %>
                  <%= project.organization_name || "Unavailable" %>
                <% } %>
              </span>
            </li>
        <% }) %>
<p>
    <% if (user && user.role_name === 'admin') { %>
    <a href="/new-project">Add New Project</a>
    <% } %>
  </p>  </ul>
</main>

<%- include('partials/footer') %>
