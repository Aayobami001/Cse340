<%- include('partials/header') %> 
<%- include('partials/navigation') %>

<main>
  <h1><%= title %></h1>
    <ul>
       <% projects.forEach(project => { %>
            <li>
              <a href="/project/<%= project.service_project_id %>"><%= project.title %></a>
              <span>Organization:
                <% if (project.organization_id) { %>
                  <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                <% } else { %>
                  <%= project.organization_name || "Unavailable" %>
                <% } %>
              </span>
            </li>
        <% }) %>
        <p><a href="/new-project">Create New Project</a></p>
  </ul>
</main>

<%- include('partials/footer') %>
